# =============================================================================
# Konfigurasi deployment VPS — salin jadi deploy/.env.vps
#   cp deploy/.env.vps.example deploy/.env.vps
#
# File ini hanya untuk Docker Compose (bukan dibaca backend).
# Rahasia backend (DB, Redis, R2, API key) tetap di backend/.env.
# =============================================================================

# Domain yang sudah diarahkan ke IP VPS (DNS A record).
# Caddy akan mengambil sertifikat HTTPS otomatis untuk domain ini.
DOMAIN=clipzi.domainanda.com

# Username Docker Hub pemilik image (lihat §Build & Upload Docker Hub di README)
DOCKERHUB_USER=username-dockerhub

# Tag image yang dipakai. Gunakan versi spesifik (mis. 1.0.0) untuk production.
TAG=latest

# URL API yang dibaca frontend saat container start.
# Karena satu domain, cukup domain tanpa port.
NEXT_PUBLIC_API_URL=https://clipzi.domainanda.com
