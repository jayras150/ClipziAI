[Unit]
Description=ClipzyAI host metrics agent (CPU/RAM/disk/docker -> dashboard)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/clipzi-host-metrics.py
Environment=INTERVAL=5
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
