# ============================================================================
# CLIPZI AI - Environment Configuration
# ============================================================================
# Salin file ini jadi .env lalu isi nilainya.
# JANGAN commit file .env — dia sudah di .gitignore.

# --- Application ---
APP_NAME=Clipzi AI
APP_VERSION=1.0.0
DEBUG=true
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-secret-key-min-32-chars
# Prefix untuk API key. Isi HANYA prefix pendeknya, bukan contoh lengkapnya.
# Nilai "clipzy_" menghasilkan key seperti: clipzy_7f8a3b2c1d9e4f5a6b7c8d9e0f1a2b3c
API_KEY_PREFIX=clipzy_
FRONTEND_URL=http://localhost:3000

# --- Supabase: URL Project + Server Key + PostgreSQL ---
# SUPABASE_URL adalah URL project Supabase, BUKAN key.
# Ambil dari Supabase Dashboard -> Settings -> API.
SUPABASE_URL=https://zyepvsjdjlojophtglk.supabase.co
# SUPABASE_KEY hanya untuk backend. Isi dengan sb_secret_... (key baru) atau
# service_role key (legacy) bila integrasi SDK/REST Supabase dipakai.
# JANGAN taruh key ini di frontend atau variabel NEXT_PUBLIC_*.
SUPABASE_KEY=sb_secret_FLNvH-hfgthndgtrswztge
# DATABASE_URL adalah koneksi langsung PostgreSQL untuk SQLAlchemy, BUKAN
# Supabase API key. Untuk Supabase cloud, ambil dari Dashboard -> Connect ->
# Database dan gunakan prefix postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clipzyai

# --- Redis (untuk antrean job ARQ, rate limiting, cache, progress) ---
# Daftar gratis di https://console.upstash.com -> Create Database (Redis).
# Buka database -> tab "Connect" -> pilih bagian "redis-cli / TCP" (bukan REST API).
# Format: rediss://default:<PASSWORD>@<hostname>.upstash.io:6379
# Alternatif lokal (Docker): docker compose --profile local-redis up -d
REDIS_URL=redis://localhost:6379/0

# --- Cloudflare R2 Storage ---
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=clipzi-bucket
R2_PUBLIC_DOMAIN=https://your-r2-public-domain.r2.dev

# --- YouTube Data API v3 ---
# Client ID & Secret dari Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
YOUTUBE_CLIENT_ID=your-google-client-id
YOUTUBE_CLIENT_SECRET=your-google-client-secret
# Callback URL: harus didaftarkan di Google Cloud Console (sama dengan di sini)
# Format: http://localhost:8000/api/youtube/callback  (local)
#         https://domain.com/api/youtube/callback       (production)
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback
# API Key untuk akses publik (misal: search video, cek channel stats)
YOUTUBE_API_KEY=your-youtube-api-key

# --- AI Provider (dipakai oleh viral scoring, metadata, dan fitur AI lain) ---
# Pilih: openai | groq | openrouter | together | deepseek | mistral | azure | ollama | custom
AI_PROVIDER=openai
# Untuk Ollama lokal API key boleh kosong. Provider cloud isi API key di sini.
AI_API_KEY=sk-your-provider-api-key
# Base URL provider opsional. Ollama lokal biasanya memakai endpoint ini.
AI_BASE_URL=
# Gunakan nama model yang tersedia di provider Anda.
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# --- Audio Transcription / Whisper ---
# DISARANKAN: pakai API provider (openai | groq | openrouter | together | custom).
#   Provider harus kompatibel OpenAI /audio/transcriptions dan mendukung
#   response_format "verbose_json" + timestamp segment/word.
#   Groq (murah & cepat): https://api.groq.com/openai/v1 + whisper-large-v3-turbo
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_API_KEY=
# PENTING: isi base URL provider (root /v1), BUKAN endpoint lengkap.
# SDK openai otomatis menambahkan "/audio/transcriptions" ke nilai ini.
# Contoh: https://api.groq.com/openai/v1  |  https://openrouter.ai/api/v1
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Butuh transkripsi LOKAL (tanpa API)? Paketnya tidak dipasang default:
#   pip install -r requirements-whisper-local.txt
# lalu set TRANSCRIPTION_PROVIDER=local dan WHISPER_MODEL=small

# --- Fallback Key untuk AI & Transkripsi (semua provider) ---
# OPENAI_API_KEY adalah key cadangan universal:
#   - Untuk AI (LLM): dipakai jika AI_API_KEY kosong
#   - Untuk transkripsi: dipakai jika TRANSCRIPTION_API_KEY dan AI_API_KEY kosong
# Isi dengan API key dari provider mana pun (OpenAI, Groq, OpenRouter, DeepSeek, dll).
OPENAI_API_KEY=sk-your-openai-api-key
# WHISPER_MODEL hanya dipakai jika TRANSCRIPTION_PROVIDER=local (faster-whisper).
# Pilihan: tiny / base / small / medium / large-v3. Semakin besar, semakin akurat tapi butuh lebih banyak RAM.
WHISPER_MODEL=small

# --- Duitku Payment Gateway ---
DUITKU_MERCHANT_CODE=your-merchant-code
DUITKU_API_KEY=your-api-key
DUITKU_CALLBACK_URL=http://localhost:8000/api/payment/callback
DUITKU_RETURN_URL=http://localhost:3000/dashboard/billing
DUITKU_SANDBOX=true

# --- Social Auth (Google, X/Twitter, Facebook) ---
# CLIENT_ID & SECRET dari masing-masing developer console.
# Callback URL yang harus didaftarkan di developer console:

# Google Cloud Console:
#   Callback: http://localhost:8000/api/auth/google/callback   (local)
#             https://domain.com/api/auth/google/callback      (production)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# X/Twitter Developer Portal:
#   Callback: http://localhost:8000/api/auth/x/callback        (local)
#             https://domain.com/api/auth/x/callback           (production)
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret

# Facebook Developer Console:
#   Callback: http://localhost:8000/api/auth/facebook/callback (local)
#             https://domain.com/api/auth/facebook/callback    (production)
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# --- Encryption (AES-256-GCM) ---
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=base64-encoded-32-byte-key-here

# --- Video Processing ---
MAX_VIDEO_DURATION_MINUTES=120
MAX_FILE_SIZE_MB=2000
OUTPUT_FPS=30
OUTPUT_RESOLUTION=1080x1920

# --- yt-dlp / Cookies (OPSIONAL) ---
# Kosongkan kalau hanya memproses video publik dari IP residensial.
# Isi HANYA jika muncul error "Sign in to confirm you're not a bot"
# (umum di IP Vast.ai/VPS/datacenter) atau butuh video age-restricted/private.
#
# Cara 1 (praktis untuk Docker): isi cookies.txt yang di-encode base64.
#   Ekspor cookies dengan ekstensi browser "Get cookies.txt LOCALLY" saat
#   sudah login YouTube, lalu jalankan:
#       python scripts/encode_cookies.py cookies.txt
#   Tempel hasilnya ke YTDLP_COOKIES_BASE64.
#
# Cara 2: taruh file cookies.txt di server dan isi path-nya
#   (contoh Docker: mount file lalu set YTDLP_COOKIES_FILE=/app/cookies.txt).
YTDLP_COOKIES_BASE64=
YTDLP_COOKIES_FILE=
# Proxy opsional untuk mengakali blokir IP datacenter.
YTDLP_PROXY=
# Opsional, mis. youtube:player_client=web_safari,android
YTDLP_EXTRACTOR_ARGS=

# --- Rotasi cookies otomatis (DISARANKAN untuk produksi) ---
# Cookies dikelola di DATABASE (tabel ytdlp_cookies, terenkripsi AES-256-GCM)
# sehingga bisa dirotasi tanpa redeploy:
#   POST /api/admin/ytdlp-cookies            -> upload cookies baru
#   POST /api/admin/ytdlp-cookies/probe-all  -> cek semua, tandai expired
#   python scripts/check_ytdlp_cookies.py    -> jalankan via cron (mis. tiap 6 jam)
# Prioritas di downloader: pool DB > YTDLP_COOKIES_FILE > YTDLP_COOKIES_BASE64.
YTDLP_COOKIE_MAX_FAILURES=3
# Video publik untuk uji validitas cookies saat probe.
YTDLP_COOKIE_PROBE_URL=https://www.youtube.com/watch?v=BaW_jenozKc

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@clipzi.ai

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://clipzi.ai

# --- Deployment Hybrid: VPS (API + frontend) + Vast.ai Serverless (GPU) ---
# Panduan lengkap: deploy/README.md §8 (Siapkan GPU worker) dan
# README.md §Arsitektur Hybrid.
#
# API + frontend jalan di satu VPS. Proses video berat dikirim ke endpoint
# Vast.ai serverless (GPU, scale-to-zero).

# API key Vast.ai: https://cloud.vast.ai/account/  (atau `vastai set api-key <KEY>`)
VAST_API_KEY=
# Nama endpoint (dipakai scripts/vastai-setup.py, harus unik dalam akun Anda)
VAST_ENDPOINT_NAME=clipzi-processing

# ---------------------------------------------------------------------------
# VAST_WORKER_IMAGE vs VAST_TEMPLATE_HASH — dua cara menunjuk image worker.
# Cukup pilih SALAH SATU; keduanya boleh diisi (template menang).
#
# Vast.ai "template" = pembungkus `docker run`: menyimpan image, port yang
# dibuka, env yang di-set, dan ukuran disk. Workergroup butuh template ATAU
# search_params.
#
# CARA A — tanpa template (paling cepat):
#   1. Push image backend ke Docker Hub, mis.  budi/clipzi-backend:1.0.0
#   2. Isi:
#        VAST_WORKER_IMAGE=budi/clipzi-backend:1.0.0
#      (VAST_TEMPLATE_HASH dibiarkan kosong)
#   3. scripts/vastai-setup.py akan mengirim image ini lewat launch_args
#      (`--image ...`) dan filter GPU lewat search_params.
#
# CARA B — dengan template (disarankan; port & env tersimpan permanen):
#   1. Buat template sekali:
#        python scripts/vastai-setup.py template
#      (atau manual di cloud.vast.ai/templates -> + New)
#   2. Script mencetak hash, mis.  79ebdd2ebfb9d42cedf7a221c42d37a5
#   3. Isi:
#        VAST_TEMPLATE_HASH=79ebdd2ebfb9d42cedf7a221c42d37a5
#   4. VAST_WORKER_IMAGE boleh tetap diisi (dipakai saat membuat template).
#
# Template Clipzi harus berisi (dibuat otomatis oleh perintah di atas):
#   image        : <user>/clipzi-backend:<tag>
#   docker options: -p 8000:8000 -e CLIPZI_ROLE=worker
#   disk         : 40 GB
# ---------------------------------------------------------------------------
VAST_WORKER_IMAGE=
VAST_TEMPLATE_HASH=
# Nama & pengaturan template saat dibuat oleh `vastai-setup.py template`
VAST_TEMPLATE_NAME=clipzi-worker
VAST_WORKER_DISK=40
# Opsional: perintah onstart tambahan (jarang perlu)
VAST_WORKER_ONSTART=
# Set 1 kalau template ingin dipublikasikan ke marketplace template Vast
VAST_TEMPLATE_PUBLIC=0

# Filter GPU marketplace (dipakai bila VAST_TEMPLATE_HASH kosong).
# Sintaks sama dengan `vastai search offers`, mis:
#   gpu_name=RTX_4090        gpu_ram>=16     num_gpus=1
#   inet_down>200            disk_space>=40  datacenter=True
VAST_GPU_FILTER=gpu_ram>=16 disk_space>=40 inet_down>200
# Autoscaling: 0 = scale-to-zero saat idle (GPU tidak ditagih, hanya storage)
VAST_MIN_WORKERS=0
VAST_MAX_WORKERS=4
VAST_TARGET_UTIL=0.9
# Detik tanpa trafik sebelum worker boleh dihentikan (scale to zero)
VAST_INACTIVITY_TIMEOUT=300
# Kosongkan VAST_ENDPOINT_URL untuk memakai mode SDK (butuh paket `vastai`
# di image API). Isi bila ingin mode HTTP langsung ke endpoint:
#   VAST_ENDPOINT_URL=https://<endpoint>.run.vast.ai
VAST_ENDPOINT_URL=

# --- Mode dispatch (paksa manual) -------------------------------------------
# Kosong = otomatis: http (kalau VAST_ENDPOINT_URL) -> sdk -> inline.
# Pilihan:
#   http    : POST {VAST_ENDPOINT_URL}/process                    (default produksi)
#   sdk     : Serverless.queue_endpoint_request                   (butuh paket vastai)
#   oneshot : BUAT instance GPU per task lalu HAPUS setelah selesai (paket vastai)
#   inline  : pipeline jalan di proses API                        (hanya dev)
# VAST_DISPATCH_MODE=
#
# Mode `oneshot` = "user klik start -> instance dibuat -> selesai -> dihapus".
# Instance butuh ~2-5 menit untuk siap, jadi pakai untuk task besar/langka.
# Secret (DATABASE_URL, R2_*, API key) dibaca dari Environment Variables akun
# Vast, BUKAN dari argumen CLI. Set sekali:
#   vastai create env-var DATABASE_URL "postgresql+asyncpg://..."
#   python scripts/vastai-run-once.py --task-id <UUID> --push-env
VAST_ONESHOT_MAX_PRICE=0
# Batas total umur instance (detik) sebelum dihapus paksa
VAST_ONESHOT_TIMEOUT=3600
# Batas waktu worker mulai memproses; lewat ini task ditandai error & instance dihapus
VAST_ONESHOT_BOOT_TIMEOUT=900
# Interval polling status task oleh reaper (detik)
VAST_ONESHOT_REAP_INTERVAL=20

# URL API yang dipakai frontend. Saat API + frontend di satu domain (Caddy),
# gunakan domain tanpa port, mis. https://clipzi.domainanda.com
# Variabel ini dibaca frontend saat container start (runtime-env.js).
NEXT_PUBLIC_API_URL=http://localhost:8000
