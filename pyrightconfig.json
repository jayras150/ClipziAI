{
  // Konfigurasi Pyright/Pylance untuk workspace Clipzi AI.
  // Backend ada di folder `backend/`, jadi `import app.*` perlu `extraPaths`.
  "pythonVersion": "3.12",
  "include": ["backend/app", "scripts"],
  "exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/node_modules",
    "frontend",
    "docker-data",
    ".next"
  ],
  "extraPaths": ["backend"],
  // Venv proyek (berisi semua dependency backend). Dibuat dengan:
  //   python -m venv backend/.venv
  //   backend/.venv/Scripts/python.exe -m pip install -r backend/requirements.txt
  "venvPath": "backend",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  // yt-dlp tidak menyertakan `py.typed`, jadi warning ini tidak informatif.
  "reportMissingModuleSource": "none"
}
