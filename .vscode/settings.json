{
  // Interpreter proyek: venv khusus backend yang berisi semua dependency.
  // Jalankan `python -m venv backend/.venv` + `pip install -r backend/requirements.txt`
  // bila folder ini belum ada.
  "python.defaultInterpreterPath": "backend\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,

  // CATATAN: python.analysis.extraPaths / typeCheckingMode /
  // diagnosticSeverityOverrides SENGAJA tidak diisi di sini karena Pylance
  // mengabaikannya bila pyrightconfig.json ada. Semua pengaturan analisis
  // Python ada di ./pyrightconfig.json.

  // Pakai TypeScript dari node_modules (5.9.3), bukan versi bawaan VS Code,
  // supaya diagnostik editor identik dengan `npx tsc --noEmit`.
  "js/ts.tsdk.path": "frontend/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsserver.maxMemory": 3072,

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  // Watcher kehabisan batas = TS server berhenti membaca ulang file dan
  // menampilkan error basi (mis. "Expression expected" di layout.tsx padahal
  // `tsc` bersih). Kecualikan folder besar dari watcher/pencarian.
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/backend/.venv/**": true,
    "**/frontend/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.git/objects/**": true
  },
  "search.followSymlinks": false,
  "search.exclude": {
    "frontend/.next": true,
    "frontend/node_modules": true,
    "backend/.venv": true
  },
  "python.terminal.useEnvFile": true,
  "chat.byokUtilityModelDefault": "none"
}
