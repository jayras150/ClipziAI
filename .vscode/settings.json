{
  // Interpreter yang benar-benar berisi dependency backend.
  // (frontend/.venv hanya berisi 3 paket, bukan untuk Python backend)
  "python.defaultInterpreterPath": "C:\\Users\\WINDOWS 11 PRO\\AppData\\Local\\Microsoft\\WindowsApps\\PythonSoftwareFoundation.Python.3.12_qbz5n2kfra8p0\\python.exe",
  "python.terminal.activateEnvironment": true,

  // CATATAN: python.analysis.extraPaths / typeCheckingMode /
  // diagnosticSeverityOverrides SENGAJA tidak diisi di sini karena Pylance
  // mengabaikannya bila pyrightconfig.json ada. Semua pengaturan analisis
  // Python ada di ./pyrightconfig.json.

  // Pakai TypeScript dari node_modules (5.9.3), bukan versi bawaan VS Code,
  // supaya diagnostik editor identik dengan `npx tsc --noEmit`.
  "js/ts.tsdk.path": "frontend/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsserver.maxMemory": 3072,

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "frontend/.next": true,
    "frontend/node_modules": true
  }
}
